<%- include('../partials/page-header', { pageTitle: 'السماسرة', pageSubtitle: 'تتبع السماسرة والعملاء المحالين' }) %>

<div class="kpi-grid kpi-grid-compact mb-4">
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-user-tie"></i></div>
    <div class="kpi-body">
      <div class="kpi-label">إجمالي السماسرة</div>
      <div class="kpi-value"><%= stats.total %></div>
    </div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-check"></i></div>
    <div class="kpi-body">
      <div class="kpi-label">نشط</div>
      <div class="kpi-value"><%= stats.active %></div>
    </div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-file-lines"></i></div>
    <div class="kpi-body">
      <div class="kpi-label">لديهم حجوزات</div>
      <div class="kpi-value"><%= stats.withReservations %></div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <form class="d-flex gap-2 flex-wrap" method="GET">
    <input type="search" name="search" class="form-control form-control-sm" style="min-width:220px" value="<%= filters.search || '' %>" placeholder="بحث بالاسم أو الشركة...">
    <select name="active" class="form-select form-select-sm" style="width:auto">
      <option value="">كل الحالات</option>
      <option value="true" <%= filters.active === 'true' ? 'selected' : '' %>>نشط</option>
      <option value="false" <%= filters.active === 'false' ? 'selected' : '' %>>غير نشط</option>
    </select>
    <button class="btn btn-outline-primary btn-sm" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
  </form>
  <a href="/brokers/new" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i> سمسار جديد</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>الاسم</th>
          <th>الشركة</th>
          <th>الهاتف</th>
          <th>الحجوزات</th>
          <th>العملاء</th>
          <th>الإيرادات</th>
          <th>الحالة</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!brokers.length) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">لا يوجد سماسرة</td></tr>
        <% } %>
        <% brokers.forEach(b => { %>
          <tr>
            <td><a href="/brokers/<%= b._id %>"><%= b.name %></a></td>
            <td><%= b.company || '—' %></td>
            <td><%= (b.phones && b.phones[0]) || '—' %></td>
            <td><%= b.stats.reservationCount %></td>
            <td><%= b.stats.clientCount %></td>
            <td><%= formatCurrency(b.stats.totalRevenue) %></td>
            <td>
              <% if (b.isActive) { %>
                <span class="badge bg-success-subtle text-success">نشط</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary">غير نشط</span>
              <% } %>
            </td>
            <td>
              <a href="/brokers/<%= b._id %>" class="btn btn-sm btn-outline-primary">عرض</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %>
  <div class="card-footer d-flex justify-content-between align-items-center">
    <span class="text-muted small">صفحة <%= pagination.page %> من <%= pagination.totalPages %></span>
    <div class="btn-group btn-group-sm">
      <% if (pagination.hasPrev) { %>
        <a class="btn btn-outline-primary" href="/brokers<%= buildQueryString(filters, { page: pagination.page - 1 }) %>">السابق</a>
      <% } %>
      <% if (pagination.hasNext) { %>
        <a class="btn btn-outline-primary" href="/brokers<%= buildQueryString(filters, { page: pagination.page + 1 }) %>">التالي</a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>
