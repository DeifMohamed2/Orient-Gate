<div class="trip-hub-panel">
  <div class="trip-hub-status-chips mb-3">
    <% Object.entries(visaStatusCounts || {}).forEach(([status, count]) => { if (!count) return; %>
      <a href="/trips/<%= trip._id %>?tab=visa&visaStatus=<%= status %>" class="trip-hub-status-chip <%= filters.visaStatus === status ? 'is-active' : '' %>">
        <%= statusLabel(status) %> <strong><%= count %></strong>
      </a>
    <% }) %>
    <% if (filters.visaStatus) { %>
      <a href="/trips/<%= trip._id %>?tab=visa" class="btn btn-sm btn-outline-primary">عرض الكل</a>
    <% } %>
  </div>

  <div class="card table-card">
    <div class="card-header">تأشيرات المعتمرين (<%= visaRecords.length %>)</div>
    <div class="card-body p-0">
      <table class="table table-hover mb-0 trip-hub-table">
        <thead><tr><th>المعتمر</th><th>الحجز</th><th>الحالة</th><th>تحديث</th></tr></thead>
        <tbody>
          <% visaRecords.forEach(({ reservation, member }) => { %>
            <tr>
              <td><%= member.name %></td>
              <td><a href="/reservations/<%= reservation._id %>"><%= reservation.reservationNumber %></a></td>
              <td><%- include('../../partials/badge', { status: member.visaStatus || 'pending' }) %></td>
              <td>
                <form method="POST" action="/visa/<%= reservation._id %>/<%= member._id %>" class="d-inline-flex gap-1 align-items-center">
                  <input type="hidden" name="_method" value="PUT">
                  <input type="hidden" name="tripId" value="<%= trip._id %>">
                  <select name="visaStatus" class="form-select form-select-sm w-auto">
                    <% ['pending','submitted','approved','rejected','issued'].forEach(s => { %>
                      <option value="<%= s %>" <%= member.visaStatus === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-sm btn-outline-primary" type="submit">حفظ</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!visaRecords.length) { %>
            <tr><td colspan="4" class="text-center text-muted py-4">لا توجد سجلات تأشيرات</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
