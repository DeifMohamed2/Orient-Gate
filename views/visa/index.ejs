<div class="ops-hub-header">
  <div class="flex-grow-1 min-w-0">
    <h1 class="page-title page-title--compact">التأشيرات</h1>
    <p class="ops-hub-sub">متابعة تأشيرات المعتمرين</p>
  </div>
  <div class="page-actions ops-hub-actions">
    <div class="dropdown">
      <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="fa-solid fa-file-export me-1"></i> تصدير Excel
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/visa/export<%= buildQueryString(filters) %>">تصدير النتائج الحالية</a></li>
        <li><a class="dropdown-item" href="/visa/export?scope=all">تصدير الكل</a></li>
      </ul>
    </div>
  </div>
</div>

<div class="kpi-grid kpi-grid-compact mb-4">
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-passport"></i></div>
    <div class="kpi-body"><div class="kpi-label">النتائج</div><div class="kpi-value"><%= pagination.totalCount %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-clock"></i></div>
    <div class="kpi-body"><div class="kpi-label">قيد الانتظار</div><div class="kpi-value"><%= statusCounts.pending || 0 %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-paper-plane"></i></div>
    <div class="kpi-body"><div class="kpi-label">مُرسل</div><div class="kpi-value"><%= statusCounts.submitted || 0 %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div class="kpi-body"><div class="kpi-label">موافق / مُصدر</div><div class="kpi-value"><%= (statusCounts.approved || 0) + (statusCounts.issued || 0) %></div></div>
  </div>
</div>

<div class="ops-status-chips mb-3">
  <% visaStatuses.forEach(s => { if (!(statusCounts[s])) return; %>
    <a href="/visa<%= buildQueryString({ ...filters, visaStatus: s, page: 1 }) %>" class="ops-status-chip<%= filters.visaStatus === s ? ' is-active' : '' %>">
      <%= statusLabel(s) %> <strong><%= statusCounts[s] %></strong>
    </a>
  <% }) %>
  <% if (filters.visaStatus) { %>
    <a href="/visa<%= buildQueryString({ ...filters, visaStatus: '', page: 1 }) %>" class="btn btn-sm btn-outline-primary">عرض الكل</a>
  <% } %>
</div>

<form class="card ops-filters" method="GET" id="visaFilterForm">
  <div class="ops-filters-inner">
    <div class="ops-filter-search">
      <i class="fa-solid fa-magnifying-glass ops-filter-icon"></i>
      <input type="search" name="search" class="form-control" value="<%= filters.search || '' %>" placeholder="بحث بالاسم، الجواز، أو رقم الحجز...">
    </div>
    <div class="ops-filter-field">
      <select name="tripId" class="form-select">
        <option value="">كل الرحلات</option>
        <% trips.forEach(t => { %>
          <option value="<%= t._id %>" <%= filters.tripId === String(t._id) ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="ops-filter-field">
      <select name="visaStatus" class="form-select">
        <option value="">كل الحالات</option>
        <% visaStatuses.forEach(s => { %>
          <option value="<%= s %>" <%= filters.visaStatus === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
        <% }) %>
      </select>
    </div>
    <div class="ops-filter-actions">
      <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter me-1"></i> تطبيق</button>
      <% if (hasActiveFilters) { %><a href="/visa" class="btn btn-outline-primary">مسح</a><% } %>
    </div>
  </div>
  <div class="ops-stats">
    <span class="trip-rail-count"><%= pagination.totalCount %> نتيجة</span>
    <% if (pagination.totalPages > 1) { %>
      <span class="text-muted small">•</span>
      <span class="text-muted small">صفحة <%= pagination.page %> من <%= pagination.totalPages %></span>
    <% } %>
  </div>
</form>

<div class="card table-card ops-table-card mt-4">
  <% if (visaRecords.length) { %>
  <div class="table-responsive">
    <table class="table table-hover mb-0 ops-table">
      <thead>
        <tr>
          <th>المعتمر</th>
          <th>الجواز</th>
          <th>الرحلة</th>
          <th>الحجز</th>
          <th>العميل</th>
          <th>الحالة</th>
          <th>تحديث</th>
        </tr>
      </thead>
      <tbody>
        <% visaRecords.forEach(({ reservation, member, trip }) => { %>
          <tr>
            <td class="fw-semibold"><%= member.name %></td>
            <td class="text-muted small"><%= member.passport || '—' %></td>
            <td>
              <% if (trip?._id) { %><a href="/trips/<%= trip._id %>?tab=operations&ops=visa" class="ops-link"><%= trip.name %></a><% } else { %>—<% } %>
            </td>
            <td><a href="/reservations/<%= reservation._id %>" class="ops-link"><%= reservation.reservationNumber %></a></td>
            <td class="text-muted small">
              <% if (reservation.primaryCustomerId) { %>
                <a href="/customers/<%= reservation.primaryCustomerId %>" class="ops-link"><%= reservation.primaryCustomerName || member.name %></a>
              <% } else { %>
                <%= reservation.primaryCustomerName || '—' %>
              <% } %>
            </td>
            <td><%- include('../partials/badge', { status: member.visaStatus || 'pending' }) %></td>
            <td class="ops-row-actions">
              <form method="POST" action="/visa/<%= reservation._id %>/<%= member._id %>" class="ops-inline-form">
                <input type="hidden" name="_method" value="PUT">
                <input type="hidden" name="returnTo" value="/visa<%= buildQueryString(filters) %>">
                <select name="visaStatus" class="form-select form-select-sm">
                  <% visaStatuses.forEach(s => { %>
                    <option value="<%= s %>" <%= member.visaStatus === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
                  <% }) %>
                </select>
                <button class="btn btn-sm btn-primary" type="submit">حفظ</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %>
  <div class="card-footer ops-pagination">
    <div class="text-muted small">صفحة <%= pagination.page %> من <%= pagination.totalPages %></div>
    <div class="d-flex gap-2">
      <% if (pagination.hasPrev) { %>
        <a class="btn btn-outline-primary btn-sm" href="/visa<%= buildQueryString(filters, { page: pagination.page - 1 }) %>">السابق</a>
      <% } %>
      <% if (pagination.hasNext) { %>
        <a class="btn btn-outline-primary btn-sm" href="/visa<%= buildQueryString(filters, { page: pagination.page + 1 }) %>">التالي</a>
      <% } %>
    </div>
  </div>
  <% } %>
  <% } else { %>
    <div class="ops-empty">
      <i class="fa-solid fa-passport"></i>
      <p>لا توجد سجلات تأشيرات مطابقة</p>
      <% if (hasActiveFilters) { %><a href="/visa" class="btn btn-outline-primary btn-sm">مسح الفلاتر</a><% } %>
    </div>
  <% } %>
</div>

<script src="/js/operations-hub.js"></script>
