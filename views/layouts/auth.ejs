<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <%- include('../partials/head', { authCss: true }) %>
</head>
<body class="auth-body og-auth-body">
  <div class="auth-bg" aria-hidden="true">
    <div class="auth-bg-grid"></div>
    <div class="auth-bg-orb auth-bg-orb--1"></div>
    <div class="auth-bg-orb auth-bg-orb--2"></div>
    <div class="auth-bg-orb auth-bg-orb--3"></div>
  </div>
  <div class="auth-wrap">
    <div class="auth-panel">
      <header class="auth-panel-hero">
        <div class="auth-panel-hero-inner">
          <div class="auth-hero-icon"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i></div>
          <h2><%= appName %></h2>
          <p>نظام إدارة الحج والعمرة</p>
        </div>
      </header>
      <div class="auth-panel-body">
        <%- body %>
      </div>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/digit-normalize.js"></script>
  <script src="/js/toasts.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
