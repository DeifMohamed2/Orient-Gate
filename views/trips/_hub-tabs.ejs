<% const baseUrl = '/trips/' + trip._id; %>
<nav class="trip-hub-tabs finance-ledger-tabs mb-3" role="tablist">
  <a href="<%= baseUrl %>?tab=overview" class="nav-link <%= activeTab === 'overview' ? 'active' : '' %>">
    <i class="fa-solid fa-gauge-high me-1"></i> نظرة عامة
  </a>
  <a href="<%= baseUrl %>?tab=reservations" class="nav-link <%= activeTab === 'reservations' ? 'active' : '' %>">
    <i class="fa-solid fa-calendar-check me-1"></i> الحجوزات
    <span class="trip-hub-tab-badge"><%= tabBadges.reservations %></span>
  </a>
  <a href="<%= baseUrl %>?tab=accommodation" class="nav-link <%= activeTab === 'accommodation' ? 'active' : '' %>">
    <i class="fa-solid fa-bed me-1"></i> التسكين
    <span class="trip-hub-tab-badge"><%= tabBadges.accommodation %></span>
  </a>
  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.hasPermission && currentUser.hasPermission('finance:view')) { %>
  <a href="<%= baseUrl %>?tab=finance" class="nav-link <%= activeTab === 'finance' ? 'active' : '' %>">
    <i class="fa-solid fa-wallet me-1"></i> المالية
    <% if (tabBadges.finance > 0) { %>
      <span class="trip-hub-tab-badge trip-hub-tab-badge--warn"><%= Math.round(tabBadges.finance).toLocaleString('ar-EG') %></span>
    <% } %>
  </a>
  <% } %>
  <a href="<%= baseUrl %>?tab=operations&ops=visa" class="nav-link <%= activeTab === 'operations' ? 'active' : '' %>">
    <i class="fa-solid fa-clipboard-list me-1"></i> العمليات
    <% if (tabBadges.operations > 0) { %>
      <span class="trip-hub-tab-badge trip-hub-tab-badge--warn"><%= tabBadges.operations %></span>
    <% } %>
  </a>
  <a href="<%= baseUrl %>?tab=arrival" class="nav-link <%= activeTab === 'arrival' ? 'active' : '' %>">
    <i class="fa-solid fa-plane-arrival me-1"></i> إشعار الوصول
    <% if (tabBadges.arrival && tabBadges.arrival !== '—') { %>
      <span class="trip-hub-tab-badge<%= tabBadges.arrival === '!' ? ' trip-hub-tab-badge--warn' : '' %>"><%= tabBadges.arrival %></span>
    <% } %>
  </a>
</nav>
