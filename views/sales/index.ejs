<div class="ops-hub-header">
  <div class="flex-grow-1 min-w-0">
    <h1 class="page-title page-title--compact">المبيعات</h1>
    <p class="ops-hub-sub"><%= viewAll ? 'متابعة أداء فريق المبيعات والحجوزات' : 'حجوزاتك وعملاؤك وأداؤك' %></p>
  </div>
  <div class="page-actions ops-hub-actions">
    <div class="dropdown">
      <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="fa-solid fa-file-export me-1"></i> تصدير Excel
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/sales/export<%= buildQueryString(filters) %>">تصدير النتائج الحالية</a></li>
        <% if (viewAll) { %>
          <li><a class="dropdown-item" href="/sales/export?scope=all">تصدير الكل</a></li>
        <% } %>
      </ul>
    </div>
    <a href="/reservations/new" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i> حجز جديد</a>
  </div>
</div>

<div class="kpi-grid kpi-grid-compact mb-4">
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-file-lines"></i></div>
    <div class="kpi-body"><div class="kpi-label">الحجوزات</div><div class="kpi-value"><%= summary.bookingCount %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-coins"></i></div>
    <div class="kpi-body"><div class="kpi-label">إجمالي المبيعات</div><div class="kpi-value kpi-value-sm"><%= formatCurrency(summary.totalRevenue) %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
    <div class="kpi-body"><div class="kpi-label">المحصل</div><div class="kpi-value kpi-value-sm"><%= formatCurrency(summary.collected) %></div></div>
  </div>
  <div class="kpi-card kpi-card--icon">
    <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
    <div class="kpi-body"><div class="kpi-label">العملاء / المعتمرين</div><div class="kpi-value kpi-value-sm"><%= summary.clientCount %> / <%= summary.pilgrimCount %></div></div>
  </div>
</div>

<form class="card ops-filters mb-4" method="GET">
  <input type="hidden" name="tab" value="<%= filters.tab %>">
  <div class="ops-filters-inner">
    <div class="ops-filter-search">
      <i class="fa-solid fa-magnifying-glass ops-filter-icon"></i>
      <input type="search" name="search" class="form-control" value="<%= filters.search || '' %>" placeholder="بحث بالعميل أو رقم الحجز...">
    </div>
    <div class="ops-filter-field">
      <select name="tripId" class="form-select">
        <option value="">كل الرحلات</option>
        <% trips.forEach(t => { %>
          <option value="<%= t._id %>" <%= filters.tripId === String(t._id) ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </div>
    <% if (viewAll && salesUsers.length) { %>
    <div class="ops-filter-field">
      <select name="salesEmployeeId" class="form-select">
        <option value="">كل البائعين</option>
        <% salesUsers.forEach(s => { %>
          <option value="<%= s._id %>" <%= filters.salesEmployeeId === String(s._id) ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="ops-filter-field">
      <input type="date" name="fromDate" class="form-control" value="<%= filters.fromDate || '' %>" title="من تاريخ">
    </div>
    <div class="ops-filter-field">
      <input type="date" name="toDate" class="form-control" value="<%= filters.toDate || '' %>" title="إلى تاريخ">
    </div>
    <div class="ops-filter-field">
      <select name="status" class="form-select">
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>نشط</option>
        <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>كل الحالات</option>
        <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>مكتمل</option>
        <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>ملغي</option>
      </select>
    </div>
    <div class="ops-filter-actions">
      <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter me-1"></i> تطبيق</button>
      <% if (hasActiveFilters) { %><a href="/sales" class="btn btn-outline-primary">مسح</a><% } %>
    </div>
  </div>
  <div class="ops-stats">
    <span class="trip-rail-count"><%= summary.todayBookings %> حجز اليوم</span>
    <% if (viewAll) { %>
      <span class="text-muted small">•</span>
      <span class="text-muted small"><%= summary.sellerCount %> بائع</span>
    <% } %>
    <span class="text-muted small">•</span>
    <span class="text-muted small">متبقي: <%= formatCurrency(summary.outstanding) %></span>
  </div>
</form>

<ul class="nav nav-tabs ops-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link<%= filters.tab !== 'bookings' ? ' active' : '' %>" href="/sales<%= buildQueryString({ ...filters, tab: 'overview', page: 1 }) %>">
      <i class="fa-solid fa-ranking-star me-1"></i> أداء البائعين
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link<%= filters.tab === 'bookings' ? ' active' : '' %>" href="/sales<%= buildQueryString({ ...filters, tab: 'bookings', page: 1 }) %>">
      <i class="fa-solid fa-list me-1"></i> الحجوزات
      <span class="badge bg-light text-dark ms-1"><%= pagination.totalCount %></span>
    </a>
  </li>
</ul>

<% if (filters.tab !== 'bookings') { %>
<div class="card table-card ops-table-card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-trophy me-2 text-warning"></i>ترتيب البائعين</span>
    <span class="text-muted small"><%= leaderboard.length %> بائع</span>
  </div>
  <% if (leaderboard.length) { %>
  <div class="table-responsive">
    <table class="table table-hover mb-0 ops-table">
      <thead>
        <tr>
          <th>#</th>
          <th>البائع</th>
          <th>الحجوزات</th>
          <th>العملاء</th>
          <th>المعتمرين</th>
          <th>إجمالي المبيعات</th>
          <th>المحصل</th>
          <th>المتبقي</th>
          <th>آخر حجز</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% leaderboard.forEach((row, i) => { %>
          <tr>
            <td class="text-muted"><%= i + 1 %></td>
            <td>
              <a href="/sales/seller/<%= row.seller._id %>" class="ops-link fw-semibold"><%= row.seller.name %></a>
              <div class="text-muted small"><%= roleLabel(row.seller.role) %></div>
            </td>
            <td><span class="badge bg-light text-dark"><%= row.bookingCount %></span></td>
            <td><%= row.clientCount %></td>
            <td><%= row.pilgrimCount %></td>
            <td class="fw-semibold"><%= formatCurrency(row.totalRevenue) %></td>
            <td><%= formatCurrency(row.collected) %></td>
            <td class="<%= row.outstanding > 0 ? 'text-danger' : '' %>"><%= formatCurrency(row.outstanding) %></td>
            <td class="text-muted small"><%= row.lastBooking ? formatDate(row.lastBooking) : '—' %></td>
            <td><a href="/sales/seller/<%= row.seller._id %>" class="btn btn-icon" title="التفاصيل"><i class="fa-solid fa-chart-line"></i></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <div class="ops-empty py-5"><i class="fa-solid fa-user-tie"></i><p>لا توجد بيانات مبيعات في الفترة المحددة</p></div>
  <% } %>
</div>
<% } %>

<div class="card table-card ops-table-card">
  <div class="card-header"><%= filters.tab === 'bookings' ? 'حجوزات المبيعات' : 'أحدث الحجوزات' %></div>
  <% if (bookings.length) { %>
  <div class="table-responsive">
    <table class="table table-hover mb-0 ops-table">
      <thead>
        <tr>
          <th>رقم الحجز</th>
          <th>التاريخ</th>
          <% if (viewAll) { %><th>مسؤول المبيعات</th><% } %>
          <th>العميل</th>
          <th>الرحلة</th>
          <th>معتمرين</th>
          <th>الإجمالي</th>
          <th>الدفع</th>
          <th>الحالة</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% bookings.forEach(r => { %>
          <tr class="sales-booking-row" data-href="/reservations/<%= r._id %>">
            <td><a href="/reservations/<%= r._id %>" class="ops-link fw-semibold"><%= r.reservationNumber %></a></td>
            <td class="text-muted small"><%= formatDate(r.bookingDate) %></td>
            <% if (viewAll) { %>
              <td>
                <% if (r.salesEmployee?._id) { %>
                  <a href="/sales/seller/<%= r.salesEmployee._id %>" class="ops-link"><%= r.salesEmployee.name %></a>
                <% } else { %>—<% } %>
              </td>
            <% } %>
            <td><%= r.primaryCustomerName %></td>
            <td class="small"><%= r.tripId?.name || '—' %></td>
            <td><span class="badge bg-light text-dark"><%= r.members?.length || 0 %></span></td>
            <td class="fw-semibold"><%= formatCurrency(r.pricingSnapshot?.total) %></td>
            <td><%- include('../partials/badge', { status: r.paymentStatus }) %></td>
            <td><%- include('../partials/badge', { status: r.status }) %></td>
            <td><a href="/reservations/<%= r._id %>" class="btn btn-icon"><i class="fa-solid fa-eye"></i></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (filters.tab === 'bookings' && pagination.totalPages > 1) { %>
  <div class="card-footer ops-pagination">
    <div class="text-muted small">صفحة <%= pagination.page %> من <%= pagination.totalPages %></div>
    <div class="d-flex gap-2">
      <% if (pagination.hasPrev) { %>
        <a class="btn btn-outline-primary btn-sm" href="/sales<%= buildQueryString(filters, { page: pagination.page - 1 }) %>">السابق</a>
      <% } %>
      <% if (pagination.hasNext) { %>
        <a class="btn btn-outline-primary btn-sm" href="/sales<%= buildQueryString(filters, { page: pagination.page + 1 }) %>">التالي</a>
      <% } %>
    </div>
  </div>
  <% } %>
  <% } else { %>
    <div class="ops-empty py-5"><i class="fa-solid fa-calendar-xmark"></i><p>لا توجد حجوزات مطابقة</p></div>
  <% } %>
</div>

<script src="/js/sales-hub.js"></script>
