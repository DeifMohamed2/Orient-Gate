<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <title>خطأ · أورينت جيت</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="app-body" style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;">
  <div class="card" style="max-width:420px;text-align:center;padding:32px;">
    <i class="fa-solid fa-circle-exclamation" style="font-size:48px;color:var(--danger);margin-bottom:16px;"></i>
    <h1 style="font-size:20px;margin-bottom:8px;">حدث خطأ</h1>
    <p style="color:var(--text-3);margin-bottom:24px;"><%= message %></p>
    <a href="/" class="btn btn-primary">العودة للرئيسية</a>
  </div>
</body>
</html>
