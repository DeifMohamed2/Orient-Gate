<% const notice = typeof arrivalNotice !== 'undefined' ? arrivalNotice : null; %>
<div class="trip-hub-tab-panel trip-hub-panel">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <h2 class="h5 mb-1"><i class="fa-solid fa-plane-arrival me-2"></i> إشعار الوصول</h2>
      <p class="text-muted small mb-0">إشعار واحد لكل رحلة — متصل ببيانات الفنادق والحجوزات والنقل</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% if (notice) { %>
        <a href="/arrival-notices/<%= notice._id %>/edit" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-pen me-1"></i> تعديل الإشعار
        </a>
        <a href="/arrival-notices/<%= notice._id %>/print" class="btn btn-outline-primary btn-sm" target="_blank">
          <i class="fa-solid fa-print me-1"></i> طباعة
        </a>
      <% } else { %>
        <a href="/arrival-notices/trip/<%= trip._id %>" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-file-circle-plus me-1"></i> إنشاء من بيانات الرحلة
        </a>
      <% } %>
    </div>
  </div>

  <% if (notice) { %>
    <div class="row g-3">
      <div class="col-md-3">
        <div class="card trip-hub-mini-card h-100">
          <div class="card-body">
            <div class="text-muted small">رقم الإشعار</div>
            <div class="h4 mb-0">#<%= notice.noticeNumber %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card trip-hub-mini-card h-100">
          <div class="card-body">
            <div class="text-muted small">الحالة</div>
            <div class="mb-0">
              <% if (notice.status === 'issued') { %>
                <span class="badge bg-success">صادر</span>
              <% } else { %>
                <span class="badge bg-secondary">مسودة</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card trip-hub-mini-card h-100">
          <div class="card-body">
            <div class="text-muted small">المعتمرين</div>
            <div class="h4 mb-0"><%= notice.pilgrimCount || 0 %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card trip-hub-mini-card h-100">
          <div class="card-body">
            <div class="text-muted small">الباصات</div>
            <div class="h4 mb-0"><%= notice.busCount || 0 %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-4">
      <div class="card-header">ملخص سريع</div>
      <div class="card-body">
        <div class="row g-3 small">
          <div class="col-md-6">
            <strong>الوصول:</strong>
            <%= notice.arrivalFlightNumber || '—' %>
            — <%= notice.arrivalAirline || '—' %>
            <% if (notice.arrivalDate) { %> • <%= formatDate(notice.arrivalDate) %><% } %>
            <% if (notice.arrivalTime) { %> <%= notice.arrivalTime %><% } %>
          </div>
          <div class="col-md-6">
            <strong>المغادرة:</strong>
            <%= notice.departureFlightNumber || '—' %>
            — <%= notice.departureAirline || '—' %>
            <% if (notice.departureDate) { %> • <%= formatDate(notice.departureDate) %><% } %>
            <% if (notice.departureTime) { %> <%= notice.departureTime %><% } %>
          </div>
          <div class="col-md-6">
            <strong>مكة:</strong> <%= notice.makkahHotelName || '—' %>
          </div>
          <div class="col-md-6">
            <strong>المدينة:</strong> <%= notice.medinaHotelName || '—' %>
          </div>
          <% if (notice.groupNumbers) { %>
            <div class="col-12"><strong>المجموعات:</strong> <%= notice.groupNumbers %></div>
          <% } %>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="fa-solid fa-plane-arrival fa-3x text-muted mb-3"></i>
        <p class="text-muted mb-3">لا يوجد إشعار وصول لهذه الرحلة بعد</p>
        <a href="/arrival-notices/trip/<%= trip._id %>" class="btn btn-primary">
          <i class="fa-solid fa-file-circle-plus me-1"></i> إنشاء إشعار الوصول
        </a>
      </div>
    </div>
  <% } %>
</div>
