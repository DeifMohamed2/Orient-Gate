<%- include('../partials/page-header', { pageTitle: 'مورد جديد' }) %>
<div class="card"><div class="card-body">
  <form method="POST" action="/suppliers">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">الاسم</label><input class="form-control" name="name" required></div>
      <div class="col-md-6"><label class="form-label">الفئة</label><select name="category" class="form-select">
        <% ['hotel','flight','visa','transport','guide','insurance','other'].forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
      </select></div>
      <div class="col-md-4"><label class="form-label">مسؤول التواصل</label><input class="form-control" name="contactName"></div>
      <div class="col-md-4"><label class="form-label">الهاتف</label><input class="form-control" name="phone"></div>
      <div class="col-md-4"><label class="form-label">البريد</label><input class="form-control" name="email"></div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">حفظ</button>
  </form>
</div></div>
