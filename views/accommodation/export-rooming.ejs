<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>تسكين <%= typeof sheet !== 'undefined' ? sheet.hotel.name : trip.name %> — <%= trip.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/rooming-export.css" />
</head>
<body class="rooming-export-body" data-back-url="/trips/<%= trip._id %>?tab=accommodation"<% if (typeof autoPrint !== 'undefined' && autoPrint) { %> data-auto-print="1"<% } %>>
  <div class="rooming-export-wrap">
    <% if (typeof sheets !== 'undefined' && sheets && sheets.length) { %>
      <% sheets.forEach((s, i) => { %>
        <div class="rooming-sheet-wrap<%= i < sheets.length - 1 ? ' rooming-sheet-wrap--break' : '' %>">
          <%- include('_rooming-sheet', { sheet: s, tripName: trip.name }) %>
        </div>
      <% }) %>
    <% } else if (typeof sheet !== 'undefined' && sheet) { %>
      <%- include('_rooming-sheet', { sheet, tripName: trip.name }) %>
    <% } %>

    <div class="rooming-print-bar no-print">
      <button type="button" class="rooming-print-btn" id="roomingPrintBtn">
        طباعة / حفظ PDF
      </button>
      <a href="/trips/<%= trip._id %>?tab=accommodation" class="rooming-print-btn rooming-print-btn--muted" id="roomingBackBtn">
        رجوع للتسكين
      </a>
    </div>
  </div>

  <script src="/js/rooming-export.js"></script>
</body>
</html>
