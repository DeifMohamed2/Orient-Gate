<%- include('../partials/page-header', { pageTitle: 'تعديل السمسار', pageSubtitle: broker.name }) %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/brokers/<%= broker._id %>">
      <input type="hidden" name="_method" value="PUT">
      <%- include('_broker-form', { broker }) %>
      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-check me-1"></i> حفظ</button>
        <a href="/brokers/<%= broker._id %>" class="btn btn-outline-primary">إلغاء</a>
      </div>
    </form>
  </div>
</div>
