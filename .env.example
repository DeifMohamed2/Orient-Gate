PORT=5840
NODE_ENV=development
# Local (no auth):
MONGO_URI=mongodb://localhost:27017/travel-agency
# Production with auth (encode special chars in password; set authSource if user lives in admin):
# MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/travel-agency?authSource=admin
JWT_SECRET=your-jwt-secret-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
JWT_EXPIRES_IN=7d
