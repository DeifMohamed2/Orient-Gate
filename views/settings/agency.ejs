<div class="page-header-row mb-4">
  <div>
    <h1 class="page-title">إعدادات الوكيل</h1>
    <p class="text-muted mb-0">البيانات الثابتة التي تظهر في كل إشعار وصول</p>
  </div>
  <a href="/arrival-notices" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-arrow-right me-1"></i> إشعارات الوصول</a>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="/settings/agency">
      <input type="hidden" name="_method" value="PUT">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">اسم الوكيل</label>
          <input class="form-control" name="agentName" required value="<%= settings.agentName || '' %>" placeholder="معاد الماسية">
        </div>
        <div class="col-md-6">
          <label class="form-label">اسم الوكالة (عربي)</label>
          <input class="form-control" name="agencyNameAr" value="<%= settings.agencyNameAr || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">اسم الوكالة (إنجليزي)</label>
          <input class="form-control" name="agencyNameEn" value="<%= settings.agencyNameEn || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">مسار الشعار (اختياري)</label>
          <input class="form-control" name="logoUrl" value="<%= settings.logoUrl || '' %>" placeholder="/uploads/logo.png">
        </div>
        <div class="col-md-4">
          <label class="form-label">منفذ الوصول الافتراضي</label>
          <input class="form-control" name="defaultArrivalPort" value="<%= settings.defaultArrivalPort || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">منفذ المغادرة الافتراضي</label>
          <input class="form-control" name="defaultDeparturePort" value="<%= settings.defaultDeparturePort || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">وسيلة النقل الافتراضية</label>
          <input class="form-control" name="defaultTransportMode" value="<%= settings.defaultTransportMode || '' %>">
        </div>
      </div>
      <hr class="my-4">
      <h5 class="mb-3"><i class="fa-solid fa-coins me-2 text-primary"></i>تكاليف افتراضية وسعر الصرف</h5>
      <p class="text-muted small mb-3">تُستخدم عند إنشاء رحلة جديدة — يمكن تعديلها لكل رحلة.</p>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">الوكيل السعودي (ريال)</label>
          <input type="number" class="form-control" name="defaultVisaSaudiAgentSar" min="0" step="0.01" value="<%= settings.defaultVisaSaudiAgentSar ?? 460 %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">بوابة العمرة المصرية (جنيه)</label>
          <input type="number" class="form-control" name="defaultVisaEgyptPortalEgp" min="0" step="0.01" value="<%= settings.defaultVisaEgyptPortalEgp ?? 3000 %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">سعر صرف الريال → جنيه</label>
          <input type="number" class="form-control" name="sarToEgpRate" min="0" step="0.01" value="<%= settings.sarToEgpRate ?? 13.5 %>">
          <div class="form-text">يُحفظ مع كل دفعة عند التحصيل</div>
        </div>
      </div>
      <h6 class="mt-4 mb-2">خصومات الخدمات الافتراضية (جنيه)</h6>
      <p class="text-muted small mb-3">يُنسخ إلى كل رحلة جديدة — يُخصم عند الحجز إذا المعتمر لا يحتاج الخدمة.</p>
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label">تذكرة طيران</label>
          <input type="number" class="form-control" name="defaultDeductionFlightEgp" min="0" step="1" value="<%= settings.defaultDeductionFlightEgp ?? 5500 %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">تأشيرة</label>
          <input type="number" class="form-control" name="defaultDeductionVisaEgp" min="0" step="1" value="<%= settings.defaultDeductionVisaEgp ?? 1500 %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">انتقالات</label>
          <input type="number" class="form-control" name="defaultDeductionTransportEgp" min="0" step="1" value="<%= settings.defaultDeductionTransportEgp ?? 1000 %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">قطار الحرمين</label>
          <input type="number" class="form-control" name="defaultDeductionHaramainTrainEgp" min="0" step="1" value="<%= settings.defaultDeductionHaramainTrainEgp ?? 500 %>">
        </div>
      </div>
      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> حفظ الإعدادات</button>
      </div>
    </form>
  </div>
</div>
