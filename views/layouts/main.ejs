<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <%- include('../partials/head') %>
</head>
<body class="app-body">
  <div class="app-shell" id="appShell">
    <script>
      try {
        if (localStorage.getItem('og_sidebar_collapsed') === '1' && window.matchMedia('(min-width: 993px)').matches) {
          document.getElementById('appShell').classList.add('sidebar-collapsed');
        }
      } catch (e) { /* ignore */ }
    </script>
    <%- include('../partials/sidebar') %>
    <button type="button" class="sidebar-reopen-tab" id="sidebarReopenTab" aria-label="إظهار القائمة" title="إظهار القائمة">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="app-main">
      <%- include('../partials/topbar') %>
      <main class="app-content">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <%- script %>
  <script src="/js/digit-normalize.js"></script>
  <script src="/js/toasts.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/trip-rail.js"></script>
  <script src="/js/trip-form.js"></script>
</body>
</html>
